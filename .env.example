# Copy to .env to override the docker-compose defaults. .env is git-ignored.
# These are LOCAL DEVELOPMENT values only - never reuse them in a shared or production environment.

POSTGRES_DB=bookingcore
POSTGRES_USER=bookingcore
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

APP_PORT=8080

# demo = load sample rooms and reservations; default = empty database
SPRING_PROFILES_ACTIVE=demo
